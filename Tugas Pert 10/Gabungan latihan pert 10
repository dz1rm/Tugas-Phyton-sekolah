# ==========================================
# LATIHAN 2: DICTIONARY
# ==========================================

buku = {
    "judul": "Pulang",
    "penulis": "Leila S. Chudori",
    "tahun": "2012"
}

# menampilkan judul buku
print("Judul buku:", buku["judul"])

# menambah key stok
buku["stok"] = 10
# ubah dr 10 ke 8
buku["stok"] = 8

# menampilkan key dan value
print("\nData Buku:")
for key, value in buku.items():
    print(key, ":", value)


